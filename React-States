
import { useState } from "react";

export default function Counter() {
const [count, setCount] = useState(0);

    function incCount() {
    
        setCount(count + 1);
        console.log(count);
    }

    return (
        <>
        <div>
            <h1>Counter = {count}</h1>
            <button onClick={incCount}>Increase Counter</button>
        </div>
        </>
    )
}
